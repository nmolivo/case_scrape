{
  "configurations": [
    {
      "type": "debugpy",
      "request": "attach",
      "name": "Attach to Lambda Container",
      "connect": {
        "host": "localhost",
        "port": 5890
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/var/task"
        }
      ],
      "postDebugTask": "clean-lambda"
    }
  ]
}